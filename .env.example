# DATABASE_URL=postgresql+psycopg://relay:relay@postgres:5432/relay
# REDIS_URL=redis://redis:6379/0
FRONTEND_PORT=3010

# Optional: real-model tracking test only. Set the key in your local .env.
OPENAI_API_KEY=
