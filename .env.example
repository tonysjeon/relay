API_PORT=8000
POSTGRES_DB=relay
POSTGRES_USER=relay
POSTGRES_PASSWORD=relay
RETRY_SCAN_INTERVAL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_TIMEOUT_SECONDS=30
STEP_LEASE_SECONDS=30
LEASE_SCAN_INTERVAL_SECONDS=5
READY_SCAN_INTERVAL_SECONDS=5
